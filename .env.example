# SafePath AI - Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=safepath_super_secret_session_key_change_in_production_2026

# Database
# Default is SQLite in the project directory, or specify PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/safepath_db
DATABASE_URL=sqlite:///safepath.db

# External Services
# Public OSRM routing endpoint (default uses demo OSRM server, fallback engine enabled)
OSRM_BASE_URL=https://router.project-osrm.org
# Nominatim Geocoding endpoint
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Emergency Notification Service (Simulation mode default, Twilio / Webhook optional)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Upload Configuration
MAX_CONTENT_LENGTH=5242880  # 5 MB
UPLOAD_FOLDER=static/uploads
